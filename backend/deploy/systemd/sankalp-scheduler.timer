# ==============================================================================
# Sankalp API - Systemd Timer for Task Scheduler
# ==============================================================================
# Path: /etc/systemd/system/sankalp-scheduler.timer
# Activation: sudo systemctl daemon-reload && sudo systemctl enable --now sankalp-scheduler.timer
# Status: systemctl list-timers --all
# ==============================================================================

[Unit]
Description=Run Sankalp Laravel Task Scheduler Every Minute

[Timer]
OnCalendar=*:0/1
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
