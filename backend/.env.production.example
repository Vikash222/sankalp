# ==============================================================================
# Sankalp API - Production Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` on your production VPS and configure credentials:
# cp .env.production.example .env && php artisan key:generate
# ==============================================================================

APP_NAME=Sankalp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.sankalp.app
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ------------------------------------------------------------------------------
# Logging (Rotated Daily, Pruned After 14 Days)
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ------------------------------------------------------------------------------
# Production MySQL 8 Database
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sankalp_production
DB_USERNAME=sankalp_user
DB_PASSWORD=CHANGE_TO_STRONG_PASSWORD_32_CHARS
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Redis Cache, Sessions & Queues
# ------------------------------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# Open-Source AI LLM Engine (Llama 3.x / Qwen 2.5 / Gemma / Mistral)
# Drivers available: groq, openrouter, huggingface, ollama
# ------------------------------------------------------------------------------
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# API Keys (Provider specific)
GROQ_API_KEY=gsk_your_free_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
HUGGINGFACE_API_KEY=hf_your_token_here
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM Push Notifications)
# ------------------------------------------------------------------------------
FCM_SERVER_KEY=your_fcm_legacy_server_key_or_empty
FIREBASE_CREDENTIALS=/var/www/sankalp/backend/storage/app/firebase-credentials.json

# ------------------------------------------------------------------------------
# Mail Settings (Optional / Transactional)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@sankalp.app"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Rate Limiting & Security
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=api.sankalp.app
BCRYPT_ROUNDS=12
